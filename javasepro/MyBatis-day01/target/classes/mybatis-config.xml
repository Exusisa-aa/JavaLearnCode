<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
<!--别名配置(pojo特有)-->
    <typeAliases>
        <package name="com.self.learnFile.pojo"/>
    </typeAliases>


<!--环境选择属性default-->
    <environments default="development">
<!--生产环境-->
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="com.mysql.cj.jdbc.Driver"/>
                <property name="url" value="jdbc:mysql://127.0.0.1:3306/ex?useSSL=false"/>
                <property name="username" value="root"/>
                <property name="password" value="Aa2447439574"/>
            </dataSource>
        </environment>

<!--测试环境-->
        <environment id="test">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="com.mysql.cj.jdbc.Driver"/>
                <property name="url" value="jdbc:mysql://127.0.0.1:3306/ex?useSSL=false"/>
                <property name="username" value="root"/>
                <property name="password" value="Aa2447439574"/>
            </dataSource>
        </environment>
    </environments>

    <!--映射sql文件路径-->
    <mappers>
        <!--普通写法-->
        <!--<mapper resource="com/self/learnFile/mapper/UsersMapper.xml"/>-->

        <!--包扫描写法-->
        <package name="com.self.learnFile.mapper"/>
    </mappers>
</configuration>